{
  "name": "章悟式∞競輪OS しょーご式5点＋市場残差3点 API",
  "version": "1.2.0-dual-strategy",
  "status": "keirin_jp_5pdf_dual_strategy",
  "bet_type": "2車単",
  "race_type": "MEN_ONLY",
  "input_source": "KEIRIN.JP_ONLY",
  "inputs": [
    "KEIRIN.JP 基本情報・並び予想PDF",
    "KEIRIN.JP 直近成績①PDF",
    "KEIRIN.JP 直近成績②PDF",
    "KEIRIN.JP 着度数・H・S回数PDF",
    "KEIRIN.JP 2車単オッズPDF"
  ],
  "optional_inputs": ["EXデータスクリーンショット"],
  "ability_inputs": {
    "basic": ["競走得点", "逃", "捲", "差", "マ", "B", "脚質", "ライン"],
    "recent_short": "直近成績①補正",
    "recent_detail": "直近成績②補正",
    "recent_combination": "equal_average",
    "hs": ["1着", "2着", "3着", "着外", "H", "S"]
  },
  "strategies": {
    "shogo": {
      "candidate_count": 5,
      "ability_simulations": 100000,
      "ranking": "能力確率から算出した保守EV降順"
    },
    "residual": {
      "candidate_count": 3,
      "formula": "market * (ability / market) ** lambda",
      "lambda_default": 0.5,
      "lambda_range": [0.0, 1.0],
      "residual_simulations": 100000,
      "ranking": "残差補正後確率から算出した保守EV降順"
    }
  },
  "odds_input": {
    "source": "KEIRIN.JP",
    "requires_all_pairs": true,
    "post_close_policy": "POST_RACE_SOURCE / NO_BET"
  },
  "common_candidates_policy": "表示のみ。2方式を混ぜて再計算しない",
  "women_policy": "WOMEN_EXCLUDED / NO_BET",
  "forbidden_prediction_inputs": [
    "Web自動取得",
    "レース結果",
    "レース後データ",
    "推測による欠損補完"
  ],
  "failure_policy": "INPUT_ERROR / NO_BET"
}
